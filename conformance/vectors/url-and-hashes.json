    "contentSha256": {
      "empty": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "pageMetadataOnly": "14799be27b54261e38343a50b4e0c242f081cfc497f0e315b1ca0b8157bb4438",
      "pageMetadataAndResponses": "46bf71cfb164f3f857ff1dd0980a85d76631a22dcad2f92b12819452cbba1ec2",
      "sameAsWriter11ForTheseLowercasePaths": true
    },
    "pathOrder": {
      "mixedCase": {
        "utf8": "648c162914266d5db16db4b797e2bdc6afe56646ea6984085ccd705276d95be4",
        "enUsLocaleCompare": "73013fe0f762d2cf632789bdc1564a4752655bb51f2000e7f9b1b100a08d5823",
        "differ": true,
        "utf8Order": [
          "Responses/part-001.jsonl.zst",
          "assets/part-001.jsonl.zst",
          "page_metadata/part-001.jsonl.zst",
          "page_metadata/part-002.jsonl.zst"
        ],
        "enUsOrder": [
          "assets/part-001.jsonl.zst",
          "page_metadata/part-001.jsonl.zst",
          "page_metadata/part-002.jsonl.zst",
          "Responses/part-001.jsonl.zst"
        ],
        "note": "1.1 en-US localeCompare orders Responses after assets because it folds case. UTF-8 byte order puts Responses first, because R (U+0052) is before a (U+0061). 1.1 writers emit lowercase paths, so this does not change those archives. A 1.1 reader still accepts either digest."
      },
      "thaiLocale": {
        "paths": {
          "sitemap_urls/part-001.jsonl.zst": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "sitemaps/part-001.jsonl.zst": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        },
        "utf8": "fa0dafbf43f1f551e536353e9d1a942a8e86e41a0b58dfeaf264ef217f6b862a",
        "enUs": "fa0dafbf43f1f551e536353e9d1a942a8e86e41a0b58dfeaf264ef217f6b862a",
        "th": "85bd847f072a1a7c2d0a0497416c0d823b478aeb77dccddadbb37bd0f51c47a2",
        "utf8MatchesEnUs": true,
        "thDiffers": true,
        "note": "Locale th orders sitemaps/ before sitemap_urls/ because the underscore is not a primary difference. UTF-8 byte order and en-US order sitemap_urls/ first. Both names are registry datasets, so this is a realistic 1.1 versus 1.2 difference when the 1.1 process locale was th. A 1.1 reader accepts the byte-order digest, the en-US digest, and the th digest."
      }
    },
