{
  "name": "@caifrazier/atls-spec",
  "version": "1.3.1",
  "description": "Atlas (.atls) archive specification: Zod schemas, JSON Schemas, TypeScript types, and identity helpers",
  "type": "module",
  "author": "Cai Frazier",
  "license": "Apache-2.0",
  "keywords": [
    "atlas",
    "atls",
    "archive",
    "crawler",
    "seo",
    "accessibility",
    "specification",
    "json-schema",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiFrazier/atls.git",
    "directory": "packages/atls-spec"
  },
  "bugs": {
    "url": "https://github.com/CaiFrazier/atls/issues"
  },
  "homepage": "https://github.com/CaiFrazier/atls/tree/main/packages/atls-spec#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*",
      "import": "./dist/schemas/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SPECIFICATION.md",
    "docs",
    "LICENSE",
    "LICENSE-SPEC.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b && node dist/schemas/generator.js",
    "build:schemas": "node dist/schemas/generator.js",
    "dev": "tsc -b --watch",
    "test": "VITEST_POOL=forks VITEST_MIN_WORKERS=1 VITEST_MAX_WORKERS=1 vitest run --pool=forks --minWorkers=1 --maxWorkers=1",
    "lint": "eslint .",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@types/node": "^20.14.10",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
